{
 "openapi": "3.0.3",
 "info": {
  "title": "Freya Bank collections tools",
  "version": "0.3-draft",
  "description": "Mock of the bank's systems for the Build the Builder hackathon. We host it. Every call is written to the ledger the scorer reads. The service does not enforce the brief: it records a promise on a holiday or past the deadline without complaint. Following the brief is the agent's job. The seven tool calls need no key: the customer_id in the body is the secret of one call."
 },
 "servers": [
  {
   "url": "https://rehearsal-mock.example.workers.dev/v2"
  }
 ],
 "components": {
  "schemas": {
   "VerifyIdentityIstek": {
    "type": "object",
    "properties": {
     "customer_id": {
      "type": "string"
     },
     "field": {
      "type": "string",
      "enum": [
       "date_of_birth",
       "phone_last4"
      ]
     },
     "answer": {
      "type": "string",
      "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits."
     }
    },
    "required": [
     "customer_id",
     "field",
     "answer"
    ]
   },
   "VerifyIdentityYanit": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     },
     "verified": {
      "type": "boolean"
     },
     "wrong_answers_left": {
      "type": "integer"
     },
     "all_verified": {
      "type": "boolean"
     },
     "hint": {
      "type": "string",
      "enum": [
       "day_month_swapped"
      ]
     }
    }
   },
   "GetAccountIstek": {
    "type": "object",
    "properties": {
     "customer_id": {
      "type": "string"
     }
    },
    "required": [
     "customer_id"
    ]
   },
   "GetAccountYanit": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     },
     "products": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "product_id": {
         "type": "string"
        },
        "type": {
         "type": "string",
         "enum": [
          "credit_card",
          "personal_loan",
          "car_loan"
         ]
        },
        "card_last4": {
         "type": "string",
         "description": "credit cards only"
        },
        "past_due": {
         "type": "number"
        },
        "days_late": {
         "type": "integer"
        },
        "minimum_payment": {
         "type": "number",
         "description": "credit cards only"
        },
        "instalment_amount": {
         "type": "number",
         "description": "loans only"
        }
       }
      }
     }
    }
   },
   "CreatePromiseIstek": {
    "type": "object",
    "properties": {
     "customer_id": {
      "type": "string"
     },
     "product_id": {
      "type": "string"
     },
     "amount": {
      "type": "number"
     },
     "date": {
      "type": "string",
      "format": "date"
     }
    },
    "required": [
     "customer_id",
     "product_id",
     "amount",
     "date"
    ]
   },
   "CreatePromiseYanit": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     },
     "promise_id": {
      "type": "string"
     }
    }
   },
   "AddNoteIstek": {
    "type": "object",
    "properties": {
     "customer_id": {
      "type": "string"
     },
     "product_id": {
      "type": "string"
     },
     "reason": {
      "type": "string",
      "enum": [
       "refused",
       "hardship",
       "dispute",
       "paid",
       "service_error"
      ]
     },
     "text": {
      "type": "string"
     }
    },
    "required": [
     "customer_id",
     "product_id",
     "reason"
    ]
   },
   "AddNoteYanit": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     }
    }
   },
   "ScheduleCallbackIstek": {
    "type": "object",
    "properties": {
     "customer_id": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "format": "date"
     },
     "time": {
      "type": "string",
      "description": "HH:MM"
     }
    },
    "required": [
     "customer_id",
     "date",
     "time"
    ]
   },
   "ScheduleCallbackYanit": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     }
    }
   },
   "TransferToAgentIstek": {
    "type": "object",
    "properties": {
     "customer_id": {
      "type": "string"
     },
     "queue": {
      "type": "string",
      "enum": [
       "restructuring",
       "general",
       "support"
      ]
     }
    },
    "required": [
     "customer_id",
     "queue"
    ]
   },
   "TransferToAgentYanit": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     }
    }
   },
   "CloseCallIstek": {
    "type": "object",
    "properties": {
     "customer_id": {
      "type": "string"
     },
     "outcome": {
      "type": "string",
      "enum": [
       "promise",
       "paid",
       "transferred",
       "no_promise",
       "not_verified",
       "not_reached"
      ]
     },
     "reason": {
      "type": "string",
      "description": "Required for every outcome except promise and paid. See the table in the brief."
     }
    },
    "required": [
     "customer_id",
     "outcome"
    ]
   },
   "CloseCallYanit": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
     }
    }
   }
  }
 },
 "paths": {
  "/musteri/kimlik-dogrula": {
   "post": {
    "summary": "Check one security answer. Three wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/VerifyIdentityIstek"
       }
      }
     }
    },
    "responses": {
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     },
     "201": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/VerifyIdentityYanit"
        }
       }
      }
     }
    }
   }
  },
  "/musteri/hesap-ozeti": {
   "post": {
    "summary": "The late products. Refused until both questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/GetAccountIstek"
       }
      }
     }
    },
    "responses": {
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     },
     "201": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/GetAccountYanit"
        }
       }
      }
     }
    }
   }
  },
  "/odeme/soz-kaydet": {
   "post": {
    "summary": "Record a payment promise. One per product.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreatePromiseIstek"
       }
      }
     }
    },
    "responses": {
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     },
     "201": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CreatePromiseYanit"
        }
       }
      }
     }
    }
   }
  },
  "/gorusme/not-ekle": {
   "post": {
    "summary": "Brief B: record why a product ended without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AddNoteIstek"
       }
      }
     }
    },
    "responses": {
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     },
     "201": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AddNoteYanit"
        }
       }
      }
     }
    }
   }
  },
  "/gorusme/geri-arama": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ScheduleCallbackIstek"
       }
      }
     }
    },
    "responses": {
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     },
     "201": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ScheduleCallbackYanit"
        }
       }
      }
     }
    }
   }
  },
  "/gorusme/temsilciye-aktar": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/TransferToAgentIstek"
       }
      }
     }
    },
    "responses": {
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     },
     "201": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TransferToAgentYanit"
        }
       }
      }
     }
    }
   }
  },
  "/gorusme/kapat": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CloseCallIstek"
       }
      }
     }
    },
    "responses": {
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     },
     "201": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CloseCallYanit"
        }
       }
      }
     }
    }
   }
  }
 }
}