        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/InvalidArguments"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "500": {
      "$ref": "#/components/responses/TechnicalError"
     }
    }
   }
  },
  "/statement.pdf.send": {
   "post": {
    "operationId": "statement.pdf.send",
    "summary": "Sends the statement PDF by e-mail (side effect)",
    "description": "Contract suggests no automatic retry.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "data"
        ],
        "properties": {
         "data": {
          "type": "object",
          "required": [
           "customerNo",
           "cardNumber",
           "currencyType",
           "statementDate",
           "emailAddress"
          ],
          "properties": {
           "customerNo": {
            "oneOf": [
             {
              "type": "string"
             },
             {
              "type": "integer"
             }
            ],
            "description": "Customer number."
           },
           "cardNumber": {
            "type": "string",
            "description": "Card number exactly as cards.list returned it."
           },
           "currencyType": {
            "type": "string",
            "enum": [
             "TL",
             "USD",
             "EUR",
             "GBP"
            ],
            "description": "\"currencyType: \\\"TL\\\", \\\"USD\\\", \\\"EUR\\\" or \\\"GBP\\\".\""
           },
           "statementDate": {
            "type": "string",
            "description": "\"the statementDate from cards.balance (the issued statement)\", dd.MM.yyyy."
           },
           "emailAddress": {
            "type": "string",
            "description": "\"the backend sends to whatever is in this field. It does not check it against the registered address.\""
           }
          }
         },
         "call": {
          "$ref": "#/components/schemas/CallMeta"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "data",
